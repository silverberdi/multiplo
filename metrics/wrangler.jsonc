{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multiplo-metrics-local",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "vars": {
    "METRICS_INGEST_ENABLED": "false",
    "METRICS_ALLOWED_HOST": "multiplo.silverman.pro"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "multiplo-metrics-local",
      "database_id": "00000000-0000-4000-8000-000000000043",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "METRICS_RATE_LIMITER",
      "namespace_id": "43004301",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
